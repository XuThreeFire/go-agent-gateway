# 本机 Docker 教程示例，不得直接用于公网。不要把 .env 发布。
MYSQL_DATABASE=go_agent_gateway
MYSQL_USER=gateway
MYSQL_PASSWORD=gateway-local-only
MYSQL_ROOT_PASSWORD=gateway-root-local-only
DATABASE_URL=mysql://gateway:gateway-local-only@mysql:3306/go_agent_gateway?parseTime=true&loc=UTC
# 本机示例签名密钥与访问密码；公网必须分别替换为独立的随机值。
GATEWAY_SESSION_SECRET=local-tutorial-session-secret-change-before-public
GATEWAY_ACCESS_PASSWORD=gateway-local-password
OPENAI_API_KEY=
